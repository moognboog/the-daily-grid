datasource db {
  provider = "sqlite"
  url      = "file:./db/dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Score {
  id          Int      @id @default(autoincrement())
  playerId    String
  playerName  String
  avatarUrl   String?
  timeSeconds Int
  date        String
  createdAt   DateTime @default(now())

  @@unique([playerId, date])
}

model Puzzle {
  id        Int      @id @default(autoincrement())
  title     String?
  date      String?  // optional YYYY-MM-DD pin — this puzzle serves on that date only
  rows      Int
  cols      Int
  wordsJson String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

// Key-value store for server-side config (e.g. puzzle cycle tracking)
model Config {
  key   String @id
  value String
}

model WordClue {
  id   Int    @id @default(autoincrement())
  word String
  clue String

  @@unique([word, clue])
  @@index([word])
}
